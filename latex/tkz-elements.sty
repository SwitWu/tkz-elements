 \newcommand{\tkzEvalFct}[2]{%
   \directlua{tex.sprint(F["\luaescapestring{\detokenize{#1}}"]:eval(#2))}%
 }


 \newcommand{\tkzDrawPointOnGraph}[3][]{%
   \begingroup
   \edef\tkztmpy{\tkzEvalFct{#3}{#2}}%
   \tkzDrawPoint[#1](#2,\tkztmpy)%
   \endgroup
 }
\newcommand{\tkzDrawPointsOnGraph}[3][]{%
   \foreach \x in {#2}{\tkzDrawPointOnGraph[#1]{\x}{#3}}%
 }

% --- point unique sur une courbe paramétrée PF.<name>(t)
 \makeatletter
 \newcommand{\tkzDrawPointOnParamGraph}[3][]{%
   \directlua{%
     local pf = PF["#3"]
     if not pf then
       tex.error("tkz-elements", {"Parametric function PF.".."#3".." is undefined"})
     end
     z.TMP = pf:point(#2)
   }%
   \tkzGetNodes
   \tkzDrawPoint[#1](TMP)%
 }

 \newcommand{\tkzDrawPointsOnParamGraph}[3][]{%
   \foreach \t in {#2}{%
     \tkzDrawPointOnParamGraph[#1]{\t}{#3}%
   }%
 }
 \makeatother
